# ─────────────────────────────────────────────────────────────────────────
# Généré par Ansible — NE PAS ÉDITER sur l'hôte.
# Toute modification directe est écrasée au prochain déploiement : la source
# de vérité est group_vars/. Ajouter une variable = l'ajouter là-bas.
# ─────────────────────────────────────────────────────────────────────────
A=1

# ── Sauvegarde externalisée S3 (FEAT-29) — rendu depuis ciso_backup_s3 ──
# COMPOSE_FILE active docker-compose.s3.yml. Sans cette ligne, repo2
# n'existe pas : pgBackRest refuse une variable vide, une activation par
# variable conditionnelle empêcherait tout déploiement sans S3 de démarrer.
COMPOSE_FILE=docker-compose.yml:docker-compose.s3.yml:docker-compose.s3-ca.yml
BACKUP_S3_BUCKET=b
BACKUP_S3_ENDPOINT=e
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PATH=/pgbackrest
BACKUP_S3_URI_STYLE=host
BACKUP_S3_RETENTION_FULL=4
BACKUP_S3_TEST_DAY=01
BACKUP_S3_STORAGE_CA_FILE=/certs/ca.crt
BACKUP_S3_KEY=k
BACKUP_S3_KEY_SECRET=s
