---
# ─────────────────────────────────────────────────────────────────────────
# EXEMPLE de fichier d'hôte — à copier sous host_vars/<nom-de-l-hote>.yml,
# où <nom-de-l-hote> est EXACTEMENT le nom utilisé dans l'inventaire.
#
# Ce fichier porte le suffixe .example : Ansible ne le charge pas, et il
# n'entrera donc jamais en conflit avec votre configuration réelle lors
# d'une mise à jour du template.
#
# Le cas illustré est le plus délicat : la REPRISE d'un déploiement
# existant, où trois valeurs ne se changent pas sans casse.
# ─────────────────────────────────────────────────────────────────────────

# Déplacé hors de /home : les volumes portent le nom de PROJET, pas celui
# du répertoire, donc les données suivent. Séquence de bascule dans le
# README, section « Déplacer un déploiement existant ».
ciso_deploy_dir: "/opt/ciso-toolbox"
# Compte de service, pas un compte personnel : le déploiement ne doit pas
# dépendre d'une personne. Il possède l'arborescence ; les commandes docker
# tournent en root via become, donc il n'est PAS dans le groupe docker.
ciso_deploy_user: "ansible"
ciso_domain: "ciso.example.com"
ciso_http_port: 80
ciso_https_port: 443

# Version de suite déployée. Une montée se fait ICI, puis upgrade.yml.
ciso_suite_version: "v0.9.2"

# Neuf modules, audit inclus.
ciso_modules:
  - risk
  - compliance
  - vendor
  - asset
  - access
  - surface
  - appsec
  - audit
  - watch

# Images client : add-ons propres à une organisation, dépôts privés.
# Laisser vide pour un déploiement standard.
ciso_client_images: {}
#  surface: "ghcr.io/cisotoolbox/ciso-surface-<client>:v1.0.0"
#  access:  "ghcr.io/cisotoolbox/ciso-access-<client>:v1.0.0"
ciso_registry_user: ""                  # + vault_registry_password si images client

# Les certificats sont déjà sur l'hôte (certs/cert.pem, certs/key.pem) et
# correspondent aux chemins attendus par le nginx.conf de la release.
# Ansible vérifie leur présence sans y toucher.
ciso_tls_mode: "existing"

# ── Le .env ──────────────────────────────────────────────────────────────
# Extrait de l'existant par extract-env.sh : AUCUNE valeur n'a été
# régénérée. Remplacer ce bloc par le contenu de ciso_env.yml.
#
# COMPOSE_PROJECT_NAME est LA valeur critique : elle préfixe les volumes.
# Une autre valeur ferait démarrer la stack sur des bases vides — le rôle
# refuse désormais ce cas, mais ne le corrige pas à votre place.
# REMPLACER TOUT LE BLOC ci-dessous par le contenu de ciso_env.yml produit
# par extract-env.sh — il contient DÉJÀ COMPOSE_PROJECT_NAME. Le compléter
# au lieu de le remplacer crée une clé en double : YAML retient la dernière
# et n'émet qu'un avertissement, facile à manquer dans une longue sortie.
ciso_env:
  COMPOSE_PROJECT_NAME: "ciso"
