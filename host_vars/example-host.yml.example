---
# ─────────────────────────────────────────────────────────────────────────
# EXAMPLE host file — copy it to host_vars/<host-name>.yml, where
# <host-name> is EXACTLY the name used in the inventory.
#
# This file carries the .example suffix: Ansible does not load it, so it will
# never conflict with your real configuration when the template is updated.
#
# The case illustrated is the trickiest one: TAKING OVER an existing
# deployment, where three values cannot be changed without breaking it.
# ─────────────────────────────────────────────────────────────────────────

# Moved out of /home: volumes are named after the PROJECT, not the directory,
# so the data follows. The switch-over sequence is in the README, section
# "Moving an existing deployment".
ciso_deploy_dir: "/opt/ciso-toolbox"

# Account owning the deployment. The template default is "ciso", a dedicated
# service account created by the common role. Pointing it at an existing
# account — the one Ansible connects with, for instance — is a valid choice
# on an already-operated host: the role then touches neither the shell, nor
# the groups, nor the home of an account it does not own.
#
# A service account, not a personal one: the deployment must not depend on a
# person. It owns the directory tree; docker commands run as root through
# become, so it is NOT in the docker group.
ciso_deploy_user: "ciso"
ciso_domain: "ciso.example.com"
ciso_http_port: 80
ciso_https_port: 443

# Suite version deployed. An upgrade is done HERE, then upgrade.yml.
ciso_suite_version: "v0.9.2"

# Nine modules, audit included.
ciso_modules:
  - risk
  - compliance
  - vendor
  - asset
  - access
  - surface
  - appsec
  - audit
  - watch

# Client images: add-ons specific to one organisation, private repositories.
# Leave empty for a standard deployment.
ciso_client_images: {}
#  surface: "ghcr.io/cisotoolbox/ciso-surface-<client>:v1.0.0"
#  access:  "ghcr.io/cisotoolbox/ciso-access-<client>:v1.0.0"
ciso_registry_user: ""            # + vault_registry_password if client images

# The certificates are already on the host (certs/cert.pem, certs/key.pem)
# and match the paths the release's nginx.conf expects. Ansible checks they
# are there and fixes their permissions, without overwriting them.
ciso_tls_mode: "existing"

# ── The .env ─────────────────────────────────────────────────────────────
# Extracted from the existing deployment by extract-env.sh: NO value was
# regenerated.
#
# COMPOSE_PROJECT_NAME is THE critical value: it prefixes the volumes. A
# different value would start the stack on empty databases — the role now
# refuses that case, but it does not fix it for you.
#
# REPLACE THE WHOLE BLOCK below with the contents of ciso_env.yml produced by
# extract-env.sh — it ALREADY contains COMPOSE_PROJECT_NAME. Adding to it
# instead of replacing it creates a duplicate key: YAML keeps the last one
# and only emits a warning, easy to miss in a long output.
ciso_env:
  COMPOSE_PROJECT_NAME: "ciso"
