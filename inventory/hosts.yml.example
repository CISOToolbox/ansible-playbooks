---
# Copy to inventory/hosts.yml (gitignored: it carries addresses and SSH
# access details).
all:
  children:
    ciso:
      hosts:
        example-host:                           # → host_vars/example-host.yml
          ansible_host: srv.example.internal
          ansible_user: ansible
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519
