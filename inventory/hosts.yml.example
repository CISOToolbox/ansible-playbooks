---
# Copier en inventory/hosts.yml (gitignoré : il porte adresses et accès SSH).
all:
  children:
    ciso:
      hosts:
        exemple-host:                           # → host_vars/exemple-host.yml
          ansible_host: srv.exemple.internal
          ansible_user: ansible
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519
