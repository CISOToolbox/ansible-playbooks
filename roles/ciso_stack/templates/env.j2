# ─────────────────────────────────────────────────────────────────────────
# Généré par Ansible — ne pas éditer sur l'hôte, toute modification est
# écrasée au prochain déploiement. Les secrets viennent de all.vault.yml.
# ─────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ciso

APP_URL=https://{{ ciso_domain }}
PUBLIC_BASE_URL=https://{{ ciso_domain }}
HTTP_PORT={{ ciso_http_port }}
HTTPS_PORT={{ ciso_https_port }}

DB_PASSWORD={{ vault_db_password }}
JWT_SECRET={{ vault_jwt_secret }}
SERVICE_TOKEN={{ vault_service_token }}
ENCRYPTION_KEY={{ vault_encryption_key }}

BACKUP_CIPHER_PASS={{ vault_backup_cipher }}
BACKUP_AGENT_TOKEN={{ vault_backup_agent_token }}

# Restreint les modules proposés par Pilot à ceux réellement déployés.
PILOT_MODULES={{ ciso_modules | join(',') }}

{% if vault_entra_client_id %}
AUTH_MODE=pilot
ENTRA_CLIENT_ID={{ vault_entra_client_id }}
ENTRA_CLIENT_SECRET={{ vault_entra_client_secret }}
ENTRA_TENANT_ID={{ vault_entra_tenant_id }}
{% else %}
# Aucun fournisseur d'identité configuré : mode sans authentification.
# À réserver à une maquette — tout appelant est administrateur.
AUTH_MODE=none
{% endif %}
