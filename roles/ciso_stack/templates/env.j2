{# ---------------------------------------------------------------------
   .env rendered from TWO merged dictionaries:

     ciso_env   (group_vars/all/main.yml)   non-secret values, versioned
     vault_env  (group_vars/all/vault.yml)  secrets, encrypted with ansible-vault

   A key defined in both: vault_env wins.

   Why dictionaries rather than a fixed list of variables: the suite
   regularly gains settings (AI_MAX_TOKENS, PUBLIC_URL, SURFACE_SMB_*…).
   With a template enumerating keys, each of them requires a change to the
   role and is silently lost when forgotten — that is how a deployment
   drifts away from its inventory.
   --------------------------------------------------------------------- #}
# ─────────────────────────────────────────────────────────────────────────
# Generated by Ansible — DO NOT EDIT on the host.
# Any direct change is overwritten at the next deployment: the source of
# truth is group_vars/. Adding a variable means adding it there.
# ─────────────────────────────────────────────────────────────────────────
{% for key, value in (ciso_env | combine(vault_env | default({}))) | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% if ciso_backup_s3 | default({}) | length > 0 %}

# ── Off-site S3 backup — rendered from ciso_backup_s3 ───────────────────
# COMPOSE_FILE activates docker-compose.s3.yml. Without this line repo2 does
# not exist: pgBackRest refuses an empty variable, so enabling it through a
# conditional variable would stop every non-S3 deployment from starting.
COMPOSE_FILE=docker-compose.yml:docker-compose.s3.yml{{ ':docker-compose.s3-ca.yml' if ciso_backup_s3.storage_ca_file is defined else '' }}
BACKUP_S3_BUCKET={{ ciso_backup_s3.bucket }}
BACKUP_S3_ENDPOINT={{ ciso_backup_s3.endpoint }}
BACKUP_S3_REGION={{ ciso_backup_s3.region | default('us-east-1') }}
BACKUP_S3_PATH={{ ciso_backup_s3.path | default('/pgbackrest') }}
BACKUP_S3_URI_STYLE={{ ciso_backup_s3.uri_style | default('host') }}
BACKUP_S3_RETENTION_FULL={{ ciso_backup_s3.retention_full | default(4) }}
BACKUP_S3_TEST_DAY={{ ciso_backup_s3.test_day | default('01') }}
{% if ciso_backup_s3.storage_ca_file is defined %}
BACKUP_S3_CA_FILE={{ ciso_backup_s3.storage_ca_file }}
{% endif %}
BACKUP_S3_KEY={{ ciso_backup_s3_secret.key }}
BACKUP_S3_KEY_SECRET={{ ciso_backup_s3_secret.key_secret }}
{% if ciso_backup_s3_secret.cipher_pass is defined %}
BACKUP_S3_CIPHER_PASS={{ ciso_backup_s3_secret.cipher_pass }}
{% endif %}
{% endif %}
