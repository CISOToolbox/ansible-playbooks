{# ---------------------------------------------------------------------
   .env rendu à partir de DEUX dictionnaires fusionnés :

     ciso_env   (group_vars/all.yml)      valeurs non secrètes, versionnées
     vault_env  (group_vars/all.vault.yml) secrets, chiffrés par ansible-vault

   Une clé définie dans les deux : vault_env l'emporte.

   Pourquoi des dictionnaires plutôt qu'une liste figée de variables : la
   suite gagne régulièrement des réglages (AI_MAX_TOKENS, PUBLIC_URL,
   SURFACE_SMB_*…). Avec un gabarit énumérant les clés, chacun d'eux exige
   une modification du rôle et se perd silencieusement s'il est oublié —
   c'est ainsi qu'un déploiement dérive de son inventaire.
   --------------------------------------------------------------------- #}
# ─────────────────────────────────────────────────────────────────────────
# Généré par Ansible — NE PAS ÉDITER sur l'hôte.
# Toute modification directe est écrasée au prochain déploiement : la source
# de vérité est group_vars/. Ajouter une variable = l'ajouter là-bas.
# ─────────────────────────────────────────────────────────────────────────
{% for key, value in (ciso_env | combine(vault_env | default({}))) | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% if ciso_backup_s3 | default({}) | length > 0 %}

# ── Sauvegarde externalisée S3 (FEAT-29) — rendu depuis ciso_backup_s3 ──
# COMPOSE_FILE active docker-compose.s3.yml. Sans cette ligne, repo2
# n'existe pas : pgBackRest refuse une variable vide, une activation par
# variable conditionnelle empêcherait tout déploiement sans S3 de démarrer.
COMPOSE_FILE=docker-compose.yml:docker-compose.s3.yml
BACKUP_S3_BUCKET={{ ciso_backup_s3.bucket }}
BACKUP_S3_ENDPOINT={{ ciso_backup_s3.endpoint }}
BACKUP_S3_REGION={{ ciso_backup_s3.region | default('us-east-1') }}
BACKUP_S3_PATH={{ ciso_backup_s3.path | default('/pgbackrest') }}
BACKUP_S3_URI_STYLE={{ ciso_backup_s3.uri_style | default('host') }}
BACKUP_S3_RETENTION_FULL={{ ciso_backup_s3.retention_full | default(4) }}
BACKUP_S3_TEST_DAY={{ ciso_backup_s3.test_day | default('01') }}
BACKUP_S3_KEY={{ ciso_backup_s3_secret.key }}
BACKUP_S3_KEY_SECRET={{ ciso_backup_s3_secret.key_secret }}
{% if ciso_backup_s3_secret.cipher_pass is defined %}
BACKUP_S3_CIPHER_PASS={{ ciso_backup_s3_secret.cipher_pass }}
{% endif %}
{% endif %}
