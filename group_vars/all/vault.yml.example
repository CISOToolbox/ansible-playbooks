---
# ─────────────────────────────────────────────────────────────────────────
# Secrets — à chiffrer :  ansible-vault encrypt group_vars/all.vault.yml
#
# Générer chaque valeur avec :  openssl rand -hex 32
#
# ATTENTION à deux d'entre eux :
#   vault_encryption_key  chiffre les secrets stockés en base (SMTP, clés IA,
#                         jetons de connecteurs). Le CHANGER rend illisible
#                         tout ce qui a été chiffré avec l'ancien.
#   vault_backup_cipher   chiffre le dépôt pgBackRest. Le perdre rend les
#                         sauvegardes irrécupérables — le conserver hors de
#                         la machine sauvegardée.
# ─────────────────────────────────────────────────────────────────────────
vault_db_password:       "change-me"
vault_jwt_secret:        "change-me"
vault_service_token:     "change-me"
vault_encryption_key:    "change-me"
vault_backup_cipher:     "change-me"
vault_backup_agent_token: "change-me"

# Fournisseur d'identité (laisser vide pour AUTH_MODE=none, test uniquement)
vault_entra_client_id:     ""
vault_entra_client_secret: ""
vault_entra_tenant_id:     "common"

# Registre, uniquement si des images client privées sont déployées
vault_registry_password: ""
